{
    "name": "redoxbird/wp-documentation",
    "description": "WP Documentation WordPress theme",
    "type": "wordpress-theme",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4",
        "freemius/wordpress-sdk": "dev-master"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "freemius/wordpress-sdk": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Freemius\\Composer\\Script\\FreemiusEvents::postInstall"
        ]
    }
}
